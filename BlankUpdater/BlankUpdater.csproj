<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- ChilloutVR install path. Can be overridden via the CVRPATH environment variable. -->
        <CVRPATH Condition="'$(CVRPATH)' == ''">D:\SteamLibrary\steamapps\common\ChilloutVR</CVRPATH>

        <AssemblyName>CVRModUpdater.BlankLoader</AssemblyName>
        <RootNamespace>BlankUpdater</RootNamespace>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <DebugType>embedded</DebugType>
        <Optimize>true</Optimize>

        <!-- The DLL is written straight into the game's Plugins folder. -->
        <OutputPath>$(CVRPATH)\Plugins\</OutputPath>

        <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3243;MSB3277</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <ItemGroup>
        <!-- The updater only needs MelonLoader (and optionally BTKUILib), no game DLLs. -->
        <Reference Include="MelonLoader">
            <HintPath>$(CVRPATH)\MelonLoader\net35\MelonLoader.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- Optional: quick menu page. BTKUILib is only needed to build, the updater runs without it -->
        <Reference Include="BTKUILib">
            <HintPath>$(CVRPATH)\Mods\BTKUILib.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <!-- Quick menu icons, compiled into the DLL -->
        <EmbeddedResource Include="assets\icons\*.png" LogicalName="BlankUpdater.Icons.%(Filename).png" />
    </ItemGroup>

    <!-- MelonLoader locks loaded plugins; if the game is running the delete fails quietly and the build tells you. -->
    <Target Condition="'$(OS)' == 'Windows_NT'" Name="DeleteOldPluginDll" BeforeTargets="BeforeBuild">
        <Exec Command="if exist &quot;$(OutputPath)$(TargetName).dll&quot; del /F /Q &quot;$(OutputPath)$(TargetName).dll&quot;" ContinueOnError="true" />
        <!-- remove the DLL with the old name (BlankUpdater.dll) so the updater isn't loaded twice -->
        <Exec Command="if exist &quot;$(OutputPath)BlankUpdater.dll&quot; del /F /Q &quot;$(OutputPath)BlankUpdater.dll&quot;" ContinueOnError="true" />
    </Target>

</Project>
